# Dedicated private relay configuration for signed raw tx submission.
# This is separate from normal chain RPC endpoints and must point to a relay or bundler endpoint.
# PRIVATE_RELAY_RPC_URL=https://your-private-relay.example.com
# PRIVATE_RELAY_RPC_URL_BNB=https://bnb-relay.example.com
# PRIVATE_RELAY_RPC_URL_BASE=https://base-relay.example.com
# PRIVATE_RELAY_RPC_URL_ARBITRUM=https://arb-relay.example.com

# Flashloan receiver contract address (required when flashloan mode is enabled).
# FLASHLOAN_RECEIVER_ADDRESS=0xYourReceiverContract
# FLASHLOAN_PREMIUM_BPS=5

# Keep the live scanner real-only unless you intentionally opt in to a controlled test window.
# TEMP_OPPORTUNITY_FINDING_SECONDS_WINDOW=off
# Example private RPC configuration (comma-separated list supported):
# BASE_PRIVATE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY,https://base-rpc.publicnode.com

