# Real profit thresholds for the scanner. Keep these aligned with market reality.
MIN_PROFIT=50
MAX_SLIPPAGE_BPS=250
MAX_GAS_IMPACT_BPS=200
MIN_GROSS_PROFIT=5
MIN_NET_PROFIT_BPS=25
MIN_TRIAL_AMOUNT_BPS=500

# Execution pacing safety (prevents overtrading/spam loops)
# EXECUTION_PREPARE_COOLDOWN_MS=1500
# EXECUTION_CONFIRM_COOLDOWN_MS=2500
# EXECUTION_API_KEY=change-me-and-send-as-x-execution-key
# EXECUTION_API_ALLOW_UNSAFE_WITHOUT_KEY=false
# EXECUTION_SIGNER_MODE=wallet-external
# EXECUTION_SIGNER_PRIVATE_KEY=
# EXECUTION_SIGNER_KMS_KEY_ID=
# EXECUTION_SIGNER_ALLOW_SERVER_KEY_IN_PRODUCTION=false # ignored; production server-key mode stays blocked
# EXECUTION_STATE_FILE=./packages/blockchain/.runtime/execution-state.json
# CAPITAL_ACTIVE_ALLOCATION_PCT=60
# CAPITAL_RESERVE_ALLOCATION_PCT=25
# CAPITAL_EMERGENCY_ALLOCATION_PCT=15
# CAPITAL_EMERGENCY_FLOOR_USD=150
# CAPITAL_MAX_TRADE_OF_ACTIVE_PCT=35
# CAPITAL_MIN_GAS_RESERVE_ETHEREUM=0.01
# CAPITAL_MIN_GAS_RESERVE_ARBITRUM=0.007
# CAPITAL_MIN_GAS_RESERVE_BASE=0.007
# CAPITAL_MIN_GAS_RESERVE_BNB=0.02
# CAPITAL_MIN_GAS_RESERVE_POLYGON=8
# CANARY_VALIDATION_CHAIN=arbitrum
# CANARY_VALIDATION_WINDOW_HOURS=24
# CANARY_MIN_SETTLED_TRADES=3
# CANARY_MIN_REALIZED_NET_USD=1
# CANARY_MAX_AVG_SLIPPAGE_BPS=35
# CANARY_MAX_LOSS_TRADES=1
# LIVE_COST_TUNING_WINDOW_TRADES=30
# LIVE_COST_TUNING_MAX_GAS_BUFFER_USD=3
# LIVE_COST_TUNING_MAX_SLIPPAGE_MULTIPLIER=2
# LIVE_COST_TUNING_MIN_SIZING_MULTIPLIER=0.6
# Step 1: keep execution in a validation-only dry-run gate before any capital growth.
EXECUTION_OPERATION_MODE=dry-run
EXECUTION_VALIDATION_WALLETS=0x8883775cDEf766Ea517Fd2df1CadD2C748b59E34
EXECUTION_REQUIRE_CANARY_PASS_FOR_PREPARE=true
EXECUTION_REQUIRE_RELAY_RPC_DRILL_PASS_FOR_PREPARE=true
ROLLOUT_AUTOPILOT_ENABLED=false
# ALERT_WEBHOOK_URL=https://hooks.example.com/alert
# EXECUTION_REQUIRE_CANARY_PASS_FOR_PREPARE=false
# EXECUTION_REQUIRE_RELAY_RPC_DRILL_PASS_FOR_PREPARE=false
# RELAY_REQUIRED_CHAINS=arbitrum,bnb,base
# RECOVERY_WORKER_ENABLED=true
# RECOVERY_WORKER_INTERVAL_MS=15000
# RECOVERY_WORKER_MAX_ATTEMPTS=5
# RECOVERY_WORKER_BACKOFF_MS=30000
# RECOVERY_WORKER_MAX_BACKOFF_MS=300000
# RECOVERY_WORKER_SLIPPAGE_BPS=25
# SETTLEMENT_WORKER_ENABLED=true
# SETTLEMENT_WORKER_INTERVAL_MS=20000
# SETTLEMENT_WORKER_MAX_ATTEMPTS=8
# SETTLEMENT_WORKER_BACKOFF_MS=45000
# SETTLEMENT_WORKER_MAX_BACKOFF_MS=600000
# SETTLEMENT_WORKER_MIN_PROFIT_BPS=35
# SETTLEMENT_NATIVE_USD_FALLBACK=0
# NATIVE_USD_BNB=580
# ROLLOUT_AUTOPILOT_ENABLED=true
# ROLLOUT_PROMOTION_STREAK=3
# ROLLOUT_PROMOTION_COOLDOWN_MS=600000
# ROLLOUT_DEMOTION_COOLDOWN_MS=180000

# Kill-switch limits (rolling loss cap in addition to loss/slippage/rpc event caps)
# KILL_SWITCH_MAX_DAILY_LOSS_USD=75
# KILL_SWITCH_LOSS_WINDOW_HOURS=24

# All chains support private endpoints using either *_PRIVATE_RPC or *_PRIVATE_RPC_URL aliases.
# Example: BASE_PRIVATE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY,https://base-rpc.publicnode.com
# Example: ARBITRUM_PRIVATE_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY,https://arbitrum-one-rpc.publicnode.com
# Example: POLYGON_PRIVATE_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY,https://polygon-bor-rpc.publicnode.com
